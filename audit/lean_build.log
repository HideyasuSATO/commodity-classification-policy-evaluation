  (p q : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (c : ℝ) (r : CommodityClassification.Equilibrium.Vec n),
      HasFDerivAt (CommodityClassification.Equilibrium.benchmarkUtility p q D c)
        (CommodityClassification.CESCost.weightedLinear (CommodityClassification.Equilibrium.benchmarkGradient p q D r))
        r
