  (df dg : CommodityClassification.Equilibrium.Vec n) (t : ℝ),
  HasDerivAt f df t → HasDerivAt g dg t → HasDerivAt (fun x => f x ⬝ᵥ g x) (df ⬝ᵥ g t + f t ⬝ᵥ dg) t
