info: LeanMath/CommodityClassification/CheckCESCostDerivatives.lean:205:0: @coordinate_cost_shares : ∀ {n k : ℕ} (e : CommodityClassification.InputCoordinates.Frame k) (p : Vec n) (C : Mat n k)
  (hp : ∀ (i : Fin n), 0 < p i) (hw : ∀ (j : Fin (k + 1)), 0 < e.w j) (hC : C ∈ e.PositiveDomain p) (i : Fin n),
  (∀ (j : Fin (k + 1)), 0 < (ofCoordinates e p C hp hw hC i).share j) ∧
    ∑ j, (ofCoordinates e p C hp hw hC i).share j = 1
info: LeanMath/CommodityClassification/CheckCESCostDerivatives.lean:206:0: 'CommodityClassification.CESCost.coordinate_cost_shares' depends on axioms: [propext, Classical.choice, Quot.sound]
info: LeanMath/CommodityClassification/CheckCESCostDerivatives.lean:208:0: @coordinate_cost_formulas : ∀ {n k : ℕ} (e : CommodityClassification.InputCoordinates.Frame k) (p : Vec n) (C : Mat n k)
  (hp : ∀ (i : Fin n), 0 < p i) (hw : ∀ (j : Fin (k + 1)), 0 < e.w j) (hC : C ∈ e.PositiveDomain p) (σ : ℝ) (i : Fin n),
  have d := ofCoordinates e p C hp hw hC i;
  d.cost σ e.w = p i ∧
    (∀ w ∈ PositivePrices (k + 1), ContDiffAt ℝ ⊤ (d.cost σ) w) ∧
      (∀ (u : Vec (k + 1)), (fderiv ℝ (d.cost σ) e.w) u = e.reconstruct p C i ⬝ᵥ u) ∧
        (∀ (j l : Fin (k + 1)),
            pricePartial (pricePartial (d.cost σ) j) l e.w =
              σ *
                (e.reconstruct p C i j * e.reconstruct p C i l / p i -
                  if j = l then e.reconstruct p C i j / e.w j else 0)) ∧
          ∀ (u v : Vec (k + 1)),
            (fderiv ℝ (fun w => (fderiv ℝ (d.cost σ) w) v) e.w) u =
              σ *
                (e.reconstruct p C i ⬝ᵥ u * e.reconstruct p C i ⬝ᵥ v / p i -
                  ∑ j, e.reconstruct p C i j / e.w j * u j * v j)
