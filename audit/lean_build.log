info: LeanMath/CommodityClassification/CheckAllManuscript.lean:6167:0: @CommodityClassification.Precision.Data.perturbed_moment_width_bound : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) (D : CommodityClassification.InputCoordinates.Mat n n)
  (b : CommodityClassification.InputCoordinates.Vec n) (δ τ : ℝ),
  0 ≤ δ →
    ∀ (hδ1 : δ < 1),
      0 ≤ τ →
        τ < 1 →
          ∀ (hlo : Matrix.PosSemidef (D - (1 - δ) • d.demand)),
            Matrix.PosSemidef ((1 + δ) • d.demand - D) →
              (b - d.policy) ⬝ᵥ Matrix.mulVec d.demand (b - d.policy) ≤ τ ^ 2 * d.nu →
                have hD := ⋯;
                d.perturbedWidth D hD b d.momentReport ≤
                  2 * CommodityClassification.Robust.errorConstant δ τ /
                    CommodityClassification.Robust.normalizationLower δ τ
