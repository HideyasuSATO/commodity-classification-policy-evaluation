info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3209:0: @CommodityClassification.Equilibrium.matching_utility_benchmark_household : ∀ {n : ℕ}
  (p q : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (utility : CommodityClassification.Equilibrium.Vec n → ℝ) (c s income : ℝ)
      (U : Set (CommodityClassification.Equilibrium.Vec n)),
      q ∈ U →
        (∀ r ∈ U, utility r = CommodityClassification.Equilibrium.benchmarkUtility p q D c r) →
          p ⬝ᵥ q + s = income → ∀ r ∈ U, ∀ (z : ℝ), p ⬝ᵥ r + z ≤ income → utility r + z ≤ utility q + s
