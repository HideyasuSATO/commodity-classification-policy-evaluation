info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3161:0: @CommodityClassification.Equilibrium.benchmarkUtility_strict_increase : ∀ {n : ℕ}
  (p q : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (c : ℝ) (r t : CommodityClassification.Equilibrium.Vec n),
      (∀ (i : Fin n), 0 < CommodityClassification.Equilibrium.benchmarkGradient p q D r i) →
        (∀ (i : Fin n), 0 < CommodityClassification.Equilibrium.benchmarkGradient p q D t i) →
          r ≤ t →
            r ≠ t →
              CommodityClassification.Equilibrium.benchmarkUtility p q D c r <
                CommodityClassification.Equilibrium.benchmarkUtility p q D c t
