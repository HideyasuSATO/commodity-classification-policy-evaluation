  (C : CommodityClassification.CESCost.Mat n k) (hp : ∀ (i : Fin n), 0 < p i) (hw : ∀ (j : Fin (k + 1)), 0 < e.w j)
  (hC : C ∈ e.PositiveDomain p) (i : Fin n),
  (CommodityClassification.CESCost.ofCoordinates e p C hp hw hC i).a = e.reconstruct p C i ∧
    (CommodityClassification.CESCost.ofCoordinates e p C hp hw hC i).w0 = e.w ∧
      (CommodityClassification.CESCost.ofCoordinates e p C hp hw hC i).p = p i
