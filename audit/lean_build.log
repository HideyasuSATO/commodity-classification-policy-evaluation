info: LeanMath/CommodityClassification/CheckStatements.lean:20:0: structure CommodityClassification.FixedAnswer.Data.Hypotheses {n k r : ℕ} (a : Data n k r) (U : Set (Mat r k)) : Prop
number of parameters: 5
fields:
  CommodityClassification.FixedAnswer.Data.Hypotheses.relative_dimension_positive : 0 < k
  CommodityClassification.FixedAnswer.Data.Hypotheses.base_symmetric : Matrix.transpose a.base = a.base
  CommodityClassification.FixedAnswer.Data.Hypotheses.L_symmetric : Matrix.transpose a.L = a.L
  CommodityClassification.FixedAnswer.Data.Hypotheses.directions_independent : Function.Injective fun z =>
      Matrix.mulVec a.N z
  CommodityClassification.FixedAnswer.Data.Hypotheses.domain_open : IsOpen U
  CommodityClassification.FixedAnswer.Data.Hypotheses.origin_mem : 0 ∈ U
  CommodityClassification.FixedAnswer.Data.Hypotheses.K_posDef : ∀ Z ∈ U, Matrix.PosDef (a.K (a.point Z))
constructor:
  CommodityClassification.FixedAnswer.Data.Hypotheses.mk {n k r : ℕ} {a : Data n k r} {U : Set (Mat r k)}
    (relative_dimension_positive : 0 < k) (base_symmetric : Matrix.transpose a.base = a.base)
    (L_symmetric : Matrix.transpose a.L = a.L)
    (directions_independent : Function.Injective fun z => Matrix.mulVec a.N z) (domain_open : IsOpen U)
    (origin_mem : 0 ∈ U) (K_posDef : ∀ Z ∈ U, Matrix.PosDef (a.K (a.point Z))) : a.Hypotheses U
info: LeanMath/CommodityClassification/CheckStatements.lean:21:0: def CommodityClassification.FixedAnswer.Data.CongruenceCriterion : {n k r : ℕ} → Data n k r → Prop :=
fun {n k r} a =>
  a.m₀ = 0 ∧ a.r_N = 0 ∨ a.m₀ ≠ 0 ∧ a.r_N = Matrix.mulVec a.A_N a.y₀ ∧ a.S_NN = a.A_N * a.K₀⁻¹ * Matrix.transpose a.A_N
