              Matrix.of fun j l =>
                CommodityClassification.CESCost.pricePartial
                  (CommodityClassification.CESCost.pricePartial
                    ((CommodityClassification.CESCost.ofInputs A p w hA hp hw hc i).cost σ) j)
                  l w) *
            V) =
    CommodityClassification.Supply.substitution σ
      (CommodityClassification.Supply.knownR w V (CommodityClassification.Supply.totalInputs q A)) p q (A * V)
