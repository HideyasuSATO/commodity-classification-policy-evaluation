  (E E0 : CommodityClassification.Equilibrium.Model n k) (δ : ℝ),
  0 ≤ δ →
    δ ≤ 1 →
      E.C = E0.C →
        E.substitutionMatrix = E0.substitutionMatrix →
          E.b = E0.b →
            Matrix.PosDef E.D →
              Matrix.PosDef E0.D →
                Matrix.PosDef E.K →
                  Matrix.PosDef E0.K →
                    Matrix.PosSemidef E0.substitutionMatrix →
                      Matrix.PosSemidef (E.D - (1 - δ) • E0.D) →
                        Matrix.PosSemidef ((1 + δ) • E0.D - E.D) →
                          (1 - δ) * E0.lossCoefficient ≤ E.lossCoefficient ∧
                            E.lossCoefficient ≤ (1 + δ) * E0.lossCoefficient
