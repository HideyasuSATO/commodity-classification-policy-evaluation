  (hA : CommodityClassification.InputCoordinates.Positive A) (hp : ∀ (i : Fin n), 0 < p i)
  (hw : ∀ (j : Fin f), 0 < w0 j) (hc : A *ᵥ w0 = p) (i : Fin n),
  (∀ (j : Fin f), 0 < (ofInputs A p w0 hA hp hw hc i).share j) ∧ ∑ j, (ofInputs A p w0 hA hp hw hc i).share j = 1
info: LeanMath/CommodityClassification/CheckCESCostDerivatives.lean:197:0: 'CommodityClassification.CESCost.input_cost_shares' depends on axioms: [propext, Classical.choice, Quot.sound]
info: LeanMath/CommodityClassification/CheckCESCostDerivatives.lean:199:0: @input_cost_formulas : ∀ {n f : ℕ} (A : Mat n f) (p : Vec n) (w0 : Vec f)
  (hA : CommodityClassification.InputCoordinates.Positive A) (hp : ∀ (i : Fin n), 0 < p i)
  (hw : ∀ (j : Fin f), 0 < w0 j) (hc : A *ᵥ w0 = p) (σ : ℝ) (i : Fin n),
  have d := ofInputs A p w0 hA hp hw hc i;
  d.cost σ w0 = p i ∧
    (∀ w ∈ PositivePrices f, ContDiffAt ℝ ⊤ (d.cost σ) w) ∧
      (∀ (u : Vec f), (fderiv ℝ (d.cost σ) w0) u = A i ⬝ᵥ u) ∧
        (∀ (j l : Fin f),
            pricePartial (pricePartial (d.cost σ) j) l w0 =
              σ * (A i j * A i l / p i - if j = l then A i j / w0 j else 0)) ∧
          ∀ (u v : Vec f),
            (fderiv ℝ (fun w => (fderiv ℝ (d.cost σ) w) v) w0) u =
              σ * (A i ⬝ᵥ u * A i ⬝ᵥ v / p i - ∑ j, A i j / w0 j * u j * v j)
info: LeanMath/CommodityClassification/CheckCESCostDerivatives.lean:200:0: 'CommodityClassification.CESCost.input_cost_formulas' depends on axioms: [propext, Classical.choice, Quot.sound]
info: LeanMath/CommodityClassification/CheckCESCostDerivatives.lean:202:0: @coordinate_cost_inputs : ∀ {n k : ℕ} (e : CommodityClassification.InputCoordinates.Frame k) (p : Vec n) (C : Mat n k)
  (hp : ∀ (i : Fin n), 0 < p i) (hw : ∀ (j : Fin (k + 1)), 0 < e.w j) (hC : C ∈ e.PositiveDomain p) (i : Fin n),
  (ofCoordinates e p C hp hw hC i).a = e.reconstruct p C i ∧
    (ofCoordinates e p C hp hw hC i).w0 = e.w ∧ (ofCoordinates e p C hp hw hC i).p = p i
