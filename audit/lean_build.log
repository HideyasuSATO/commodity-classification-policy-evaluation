 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:872:0: @CommodityClassification.DemandNests.Data.adjusted_exchange : ∀ {n g : ℕ}
  (d : CommodityClassification.DemandNests.Data n g) (DG : CommodityClassification.InputCoordinates.Mat g g) (σ : ℝ)
  (i j : Fin n),
  i ≠ j →
    d.partition.group i = d.partition.group j →
      Matrix.mulVec (CommodityClassification.Regularity.adjustedDemand d.p d.q (d.demandMatrix DG) σ)
          (CommodityClassification.InputCoordinates.weightedExchange d.q i j) =
        CommodityClassification.InputCoordinates.twoSupport i j ((d.eta (d.partition.group i) - σ) / d.p i)
          ((d.eta (d.partition.group i) - σ) / d.p j)
