  d.TypeRespecting P →
    ∀ (c e : CommodityClassification.InputCoordinates.Vec n),
      d.Admissible c →
        e ∈ d.closedFiber P (d.groupTotal P c) →
          IsMaxOn d.secondMoment (d.closedFiber P (d.groupTotal P c)) e →
            IsLUB (d.actualWelfareDifferences P (d.groupTotal P c))
              (d.momentWidth (d.theta c ^ 2) (d.lowerMoment P (d.groupTotal P c)) (d.secondMoment e))
