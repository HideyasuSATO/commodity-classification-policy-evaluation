  (F : CommodityClassification.Equilibrium.BenchmarkFamily n k h)
  (G : CommodityClassification.InputCoordinates.Partition n g) (η : CommodityClassification.Equilibrium.Vec g)
  (hη : ∀ (a : Fin g), 0 < η a) (C : F.Candidate) (a : Fin g),
  η a = F.sigma →
    F.sigma ≠ 1 →
      ∀ {w : CommodityClassification.Equilibrium.Vec (k + 1)},
        (∀ (j : Fin (k + 1)), 0 < w j) →
          (F.nestProduction G η hη C a).compositeCost w =
            (∑ j,
                F.frame.w j * G.report F.q (F.model C).A a j / G.sales F.p F.q a *
                  (w j / F.frame.w j) ^ (1 - F.sigma)) ^
              (1 / (1 - F.sigma))
