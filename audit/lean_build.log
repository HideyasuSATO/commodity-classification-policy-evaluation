  (V : CommodityClassification.Supply.Mat f k) (hA : CommodityClassification.InputCoordinates.Positive A)
  (hp : ∀ (i : Fin n), 0 < p i) (hw : ∀ (j : Fin f), 0 < w j) (hc : Matrix.mulVec A w = p) (σ : ℝ),
  -∑ i,
        q i •
