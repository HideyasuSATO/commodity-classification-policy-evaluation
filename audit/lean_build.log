  Matrix.PosSemidef W →
    Matrix.PosSemidef D0 →
      ∀ (a τ : ℝ),
        0 ≤ a →
          0 ≤ τ →
            Matrix.PosSemidef (a • D0 - W) →
              ∀ (b b0 : CommodityClassification.Equilibrium.Vec n),
                (b - b0) ⬝ᵥ Matrix.mulVec D0 (b - b0) ≤ τ ^ 2 * b0 ⬝ᵥ Matrix.mulVec D0 b0 →
                  |b ⬝ᵥ Matrix.mulVec W b - b0 ⬝ᵥ Matrix.mulVec W b0| ≤ a * (2 * τ + τ ^ 2) * b0 ⬝ᵥ Matrix.mulVec D0 b0
