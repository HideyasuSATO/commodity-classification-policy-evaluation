  (∀ (i : Fin n), 0 < p i) →
    (∀ (i : Fin n), 0 < q i) →
      ∀ (J0 : CommodityClassification.InputCoordinates.Mat h k),
        ∀ Cref ∈ e.Candidates p q P0 J0,
          ∃ m r B H,
            P0.mean p q Cref ∈ e.Candidates p q P0 J0 ∧
              P.mean p q (P0.mean p q Cref) = P0.mean p q Cref ∧
                IsOpen (CommodityClassification.InputCoordinates.jointPositiveDomain e p (P0.mean p q Cref) B.B H.N) ∧
                  0 ∈ CommodityClassification.InputCoordinates.jointPositiveDomain e p (P0.mean p q Cref) B.B H.N ∧
                    (∀ C ∈ e.Candidates p q P0 J0,
                        ∃! z,
                          z ∈
                              CommodityClassification.InputCoordinates.jointPositiveDomain e p (P0.mean p q Cref) B.B
                                H.N ∧
                            C = P0.mean p q Cref + B.B * z.1 + H.N * z.2) ∧
                      ∀ (X : CommodityClassification.InputCoordinates.Mat m k)
                        (Z : CommodityClassification.InputCoordinates.Mat r k),
                        (X, Z) ∈
