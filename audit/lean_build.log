info: LeanMath/CommodityClassification/CheckAllManuscript.lean:5138:0: @CommodityClassification.Precision.Data.actual_coefficient_gap_scaled : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) (a b : CommodityClassification.InputCoordinates.Vec n)
  (ha : d.Admissible a) (hb : d.Admissible b),
