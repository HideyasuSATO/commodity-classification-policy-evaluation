info: LeanMath/CommodityClassification/CheckAllManuscript.lean:6170:0: @CommodityClassification.Precision.Data.perturbed_partition_width_lower : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) {m : ℕ} (P : CommodityClassification.InputCoordinates.Partition n m)
  (D : CommodityClassification.InputCoordinates.Mat n n) (b : CommodityClassification.InputCoordinates.Vec n) (δ τ : ℝ),
  0 ≤ δ →
    ∀ (hδ1 : δ < 1),
      0 ≤ τ →
        τ < 1 →
          ∀ (hlo : Matrix.PosSemidef (D - (1 - δ) • d.demand)),
            Matrix.PosSemidef ((1 + δ) • d.demand - D) →
              (b - d.policy) ⬝ᵥ Matrix.mulVec d.demand (b - d.policy) ≤ τ ^ 2 * d.nu →
                have hD := ⋯;
                (d.coarseLowerWidth m - 2 * CommodityClassification.Robust.errorConstant δ τ) /
                    CommodityClassification.Robust.normalizationUpper δ τ ≤
                  d.perturbedWidth D hD b (d.groupTotal P)
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:6171:0: 'CommodityClassification.Precision.Data.perturbed_partition_width_lower' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:6173:0: @CommodityClassification.Precision.Data.perturbed_strict_margin : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) (m : ℕ) (D : CommodityClassification.InputCoordinates.Mat n n)
  (b : CommodityClassification.InputCoordinates.Vec n) (δ τ eps : ℝ),
  0 ≤ δ →
    ∀ (hδ1 : δ < 1),
      0 ≤ τ →
        τ < 1 →
          ∀ (hlo : Matrix.PosSemidef (D - (1 - δ) • d.demand)),
            Matrix.PosSemidef ((1 + δ) • d.demand - D) →
              (b - d.policy) ⬝ᵥ Matrix.mulVec d.demand (b - d.policy) ≤ τ ^ 2 * d.nu →
                2 * CommodityClassification.Robust.errorConstant δ τ /
                      CommodityClassification.Robust.normalizationLower δ τ ≤
                    eps →
                  eps <
                      (d.coarseLowerWidth m - 2 * CommodityClassification.Robust.errorConstant δ τ) /
                        CommodityClassification.Robust.normalizationUpper δ τ →
                    have hD := ⋯;
                    d.perturbedWidth D hD b d.momentReport ≤ eps ∧
                      ∀ (P : CommodityClassification.InputCoordinates.Partition n m),
                        eps < d.perturbedWidth D hD b (d.groupTotal P)
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:6174:0: 'CommodityClassification.Precision.Data.perturbed_strict_margin' depends on axioms: [propext,
