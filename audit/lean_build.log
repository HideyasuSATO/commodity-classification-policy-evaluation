info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3149:0: @CommodityClassification.Equilibrium.benchmarkUtility_household : ∀ {n : ℕ}
  (p q v : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (c s income : ℝ),
      v ⬝ᵥ CommodityClassification.Equilibrium.affineDemand p q D v + s = income →
        ∀ (r : CommodityClassification.Equilibrium.Vec n) (z : ℝ),
          v ⬝ᵥ r + z ≤ income →
            CommodityClassification.Equilibrium.benchmarkUtility p q D c r + z ≤
              CommodityClassification.Equilibrium.benchmarkUtility p q D c
                  (CommodityClassification.Equilibrium.affineDemand p q D v) +
                s
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3150:0: 'CommodityClassification.Equilibrium.benchmarkUtility_household' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3152:0: @CommodityClassification.Equilibrium.benchmarkUtility_increment : ∀ {n : ℕ}
  (p q : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (c : ℝ) (r t : CommodityClassification.Equilibrium.Vec n),
      CommodityClassification.Equilibrium.benchmarkUtility p q D c t -
          CommodityClassification.Equilibrium.benchmarkUtility p q D c r =
        1 / 2 *
          (CommodityClassification.Equilibrium.benchmarkGradient p q D r +
              CommodityClassification.Equilibrium.benchmarkGradient p q D t) ⬝ᵥ
            (t - r)
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3153:0: 'CommodityClassification.Equilibrium.benchmarkUtility_increment' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
