info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3140:0: @CommodityClassification.Equilibrium.benchmarkUtility_combination_gap : ∀ {n : ℕ}
  (p q : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (c : ℝ) (r t : CommodityClassification.Equilibrium.Vec n) (a b : ℝ),
      a + b = 1 →
        CommodityClassification.Equilibrium.benchmarkUtility p q D c (a • r + b • t) -
            (a * CommodityClassification.Equilibrium.benchmarkUtility p q D c r +
              b * CommodityClassification.Equilibrium.benchmarkUtility p q D c t) =
          a * b / 2 * (r - t) ⬝ᵥ D⁻¹.mulVec (r - t)
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3141:0: 'CommodityClassification.Equilibrium.benchmarkUtility_combination_gap' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
