info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3185:0: @CommodityClassification.Equilibrium.household_optimum_of_surplus : ∀ {n : ℕ}
  (utility : CommodityClassification.Equilibrium.Vec n → ℝ) (v Q : CommodityClassification.Equilibrium.Vec n)
  (s income : ℝ) (U : Set (CommodityClassification.Equilibrium.Vec n)),
  v ⬝ᵥ Q + s = income →
    (∀ r ∈ U, utility r - v ⬝ᵥ r ≤ utility Q - v ⬝ᵥ Q) →
      ∀ r ∈ U, ∀ (z : ℝ), v ⬝ᵥ r + z ≤ income → utility r + z ≤ utility Q + s
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3186:0: 'CommodityClassification.Equilibrium.household_optimum_of_surplus' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3188:0: @CommodityClassification.Equilibrium.household_strict_of_surplus : ∀ {n : ℕ}
  (utility : CommodityClassification.Equilibrium.Vec n → ℝ) (v Q : CommodityClassification.Equilibrium.Vec n)
  (s income : ℝ) (U : Set (CommodityClassification.Equilibrium.Vec n)),
  v ⬝ᵥ Q + s = income →
    (∀ r ∈ U, r ≠ Q → utility r - v ⬝ᵥ r < utility Q - v ⬝ᵥ Q) →
      ∀ r ∈ U, ∀ (z : ℝ), r ≠ Q → v ⬝ᵥ r + z ≤ income → utility r + z < utility Q + s
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3189:0: 'CommodityClassification.Equilibrium.household_strict_of_surplus' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3191:0: @CommodityClassification.Equilibrium.interior_surplus_marginals : ∀ {n : ℕ}
  (utility : CommodityClassification.Equilibrium.Vec n → ℝ) (r x : CommodityClassification.Equilibrium.Vec n),
  (∀ (i : Fin n), 0 < x i) →
    DifferentiableAt ℝ utility x →
      IsMaxOn (fun y => utility y - r ⬝ᵥ y) {y | ∀ (i : Fin n), 0 ≤ y i} x →
        HasFDerivAt utility (CommodityClassification.CESCost.weightedLinear r) x
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3192:0: 'CommodityClassification.Equilibrium.interior_surplus_marginals' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3194:0: @CommodityClassification.Equilibrium.local_quadratic_demand_compatible : ∀ {n : ℕ}
  (p q : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (utility : CommodityClassification.Equilibrium.Vec n → ℝ) (c : ℝ),
      ∀ U ∈ nhds q,
        (∀ r ∈ U, utility r = c + CommodityClassification.Equilibrium.quadraticUtility p D (r - q)) →
          ∀ᶠ (v : CommodityClassification.CESCost.Vec n) in nhds p,
            HasFDerivAt utility (CommodityClassification.CESCost.weightedLinear v)
              (CommodityClassification.Equilibrium.affineDemand p q D v)
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3195:0: 'CommodityClassification.Equilibrium.local_quadratic_demand_compatible' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3197:0: @CommodityClassification.Equilibrium.local_quadratic_derivative : ∀ {n : ℕ}
  (p q : CommodityClassification.Equilibrium.Vec n) (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (utility : CommodityClassification.Equilibrium.Vec n → ℝ) (c : ℝ)
      (U : Set (CommodityClassification.Equilibrium.Vec n)),
      IsOpen U →
        (∀ r ∈ U, utility r = c + CommodityClassification.Equilibrium.quadraticUtility p D (r - q)) →
          ∀ {r : CommodityClassification.Equilibrium.Vec n},
            r ∈ U → HasFDerivAt utility (CommodityClassification.CESCost.weightedLinear (p - D⁻¹.mulVec (r - q))) r
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3198:0: 'CommodityClassification.Equilibrium.local_quadratic_derivative' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3200:0: @CommodityClassification.Equilibrium.local_utility_optimum : ∀ {n : ℕ} (p q : CommodityClassification.Equilibrium.Vec n)
  (D : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosDef D →
    ∀ (utility : CommodityClassification.Equilibrium.Vec n → ℝ) (c : ℝ),
      ∀ U ∈ nhds q,
        (∀ r ∈ U, utility r = c + CommodityClassification.Equilibrium.quadraticUtility p D (r - q)) →
          ∀ᶠ (v : CommodityClassification.Equilibrium.Vec n) in nhds p,
            CommodityClassification.Equilibrium.affineDemand p q D v ∈ U ∧
              (∀ r ∈ U,
                  utility r - v ⬝ᵥ r ≤
                    utility (CommodityClassification.Equilibrium.affineDemand p q D v) -
                      v ⬝ᵥ CommodityClassification.Equilibrium.affineDemand p q D v) ∧
                ∀ r ∈ U,
                  r ≠ CommodityClassification.Equilibrium.affineDemand p q D v →
                    utility r - v ⬝ᵥ r <
                      utility (CommodityClassification.Equilibrium.affineDemand p q D v) -
                        v ⬝ᵥ CommodityClassification.Equilibrium.affineDemand p q D v
info: LeanMath/CommodityClassification/CheckAllManuscript.lean:3201:0: 'CommodityClassification.Equilibrium.local_utility_optimum' depends on axioms: [propext, Classical.choice, Quot.sound]
