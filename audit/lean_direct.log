@CommodityClassification.Precision.Data.perturbed_width_bounds : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) {A : Type u_1} (D : CommodityClassification.InputCoordinates.Mat n n)
  (b : CommodityClassification.InputCoordinates.Vec n) (δ τ : ℝ),
  0 ≤ δ →
    ∀ (hδ1 : δ < 1),
      0 ≤ τ →
        τ < 1 →
          ∀ (hlo : Matrix.PosSemidef (D - (1 - δ) • d.demand)),
            Matrix.PosSemidef ((1 + δ) • d.demand - D) →
              (b - d.policy) ⬝ᵥ Matrix.mulVec d.demand (b - d.policy) ≤ τ ^ 2 * d.nu →
                ∀ (O : CommodityClassification.InputCoordinates.Vec n → A),
                  have hD := ⋯;
                  max (d.observationExAnteWidth O - 2 * CommodityClassification.Robust.errorConstant δ τ) 0 /
                        CommodityClassification.Robust.normalizationUpper δ τ ≤
                      d.perturbedWidth D hD b O ∧
                    d.perturbedWidth D hD b O ≤
                      (d.observationExAnteWidth O + 2 * CommodityClassification.Robust.errorConstant δ τ) /
                        CommodityClassification.Robust.normalizationLower δ τ
