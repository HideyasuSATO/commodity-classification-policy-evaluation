                HasDerivAt u (F.model C).zSolution 0 ∧
                  HasDerivAt s (F.model C).sSolution 0 ∧
                    HasDerivAt (fun t => (F.model C).quantities (t, u t)) (F.model C).qSolution 0 ∧
                      (fun t =>
                          (F.model C).welfare (F.commonUtility c) u s 0 -
                              (F.model C).welfare (F.commonUtility c) u s t -
                            1 / 2 * t ^ 2 * F.coefficient ↑C) =o[nhds 0]
                        fun t => t ^ 2
