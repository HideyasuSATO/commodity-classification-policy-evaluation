    ∀ (b b0 : CommodityClassification.Equilibrium.Vec n) (τ : ℝ),
      0 ≤ τ →
        τ ≤ 1 →
          (b - b0) ⬝ᵥ Matrix.mulVec D0 (b - b0) ≤ τ ^ 2 * b0 ⬝ᵥ Matrix.mulVec D0 b0 →
            (1 - τ) ^ 2 * b0 ⬝ᵥ Matrix.mulVec D0 b0 ≤ b ⬝ᵥ Matrix.mulVec D0 b ∧
              b ⬝ᵥ Matrix.mulVec D0 b ≤ (1 + τ) ^ 2 * b0 ⬝ᵥ Matrix.mulVec D0 b0
