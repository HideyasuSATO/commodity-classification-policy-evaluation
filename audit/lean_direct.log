@CommodityClassification.Precision.Data.sigmaWelfare_bounds : ∀ {n : ℕ} (d : CommodityClassification.Precision.Data n)
  (s : ℝ),
  0 < s →
    ∀ (c : CommodityClassification.InputCoordinates.Vec n),
      d.Admissible c → 0 ≤ d.sigmaWelfare s c ∧ d.sigmaWelfare s c ≤ 1
'CommodityClassification.Precision.Data.sigmaWelfare_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
@CommodityClassification.Precision.Data.sigmaWelfare_difference : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) (l u : ℝ),
  0 < l →
    0 < u →
      ∀ (c : CommodityClassification.InputCoordinates.Vec n),
        d.Admissible c →
          d.sigmaWelfare u c - d.sigmaWelfare l c =
            d.lossScale * d.theta c ^ 2 * (u - l) * (1 - d.secondMoment c) /
              (d.denominator l (d.secondMoment c) (d.theta c ^ 2) * d.denominator u (d.secondMoment c) (d.theta c ^ 2))
