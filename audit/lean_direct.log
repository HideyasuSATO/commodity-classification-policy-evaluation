        ∀ (hD : Matrix.PosDef D),
          0 < σ →
            have hn := ⋯;
            have lam := CommodityClassification.Regularity.demandLambda p q D hp hq hD hn;
            have R := CommodityClassification.Supply.candidateR e p q C0;
            0 < lam ∧
              Matrix.PosDef (min lam σ • R) ∧
                ∀ C ∈ e.Candidates p q P J,
                  Matrix.PosSemidef (CommodityClassification.Regularity.K p q D R σ C - min lam σ • R) ∧
                    Matrix.PosDef (CommodityClassification.Regularity.K p q D R σ C) ∧
                      Matrix.det (CommodityClassification.Regularity.K p q D R σ C) ≠ 0 ∧
