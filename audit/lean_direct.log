 Quot.sound]
@CommodityClassification.DemandNests.Data.adjustedDemand_nest_decomposition : ∀ {n g : ℕ}
  (d : CommodityClassification.DemandNests.Data n g) (DG : CommodityClassification.InputCoordinates.Mat g g) (σ : ℝ),
  CommodityClassification.Regularity.adjustedDemand d.p d.q (d.demandMatrix DG) σ =
    (Matrix.diagonal fun i => (d.eta (d.partition.group i) - σ) * (d.q i / d.p i)) +
      d.partition.Q d.q * d.outerAdjustment DG * Matrix.transpose (d.partition.Q d.q)
