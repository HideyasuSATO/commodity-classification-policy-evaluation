  (hp : ∀ (i : Fin n), 0 < p i) (hq : ∀ (i : Fin n), 0 < q i),
  (∀ (j : Fin (k + 1)), 0 < e.w j) →
    ∀ (hI : ∀ (j : Fin (k + 1)), 0 < CommodityClassification.Supply.totalInputs q (e.reconstruct p C0) j),
