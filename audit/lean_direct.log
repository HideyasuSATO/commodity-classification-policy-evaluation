  (d : CommodityClassification.DemandNests.Data n g) (DG : CommodityClassification.InputCoordinates.Mat g g),
  Matrix.IsSymm DG →
    ∀ (σ : ℝ) (R : CommodityClassification.InputCoordinates.Mat k k)
      (P : CommodityClassification.InputCoordinates.Partition n r)
      (RP : CommodityClassification.InputCoordinates.Refinement P d.partition)
      (C : CommodityClassification.InputCoordinates.Mat n k) (i j : Fin n),
      i ≠ j →
        P.group i = P.group j →
          ∀ (u : CommodityClassification.DemandNests.Vec k) (t : ℝ),
            CommodityClassification.Regularity.K d.p d.q (d.demandMatrix DG) R σ
                (P.mean d.p d.q C +
                  t • Matrix.vecMulVec (CommodityClassification.InputCoordinates.weightedExchange d.q i j) u) =
              CommodityClassification.Regularity.K d.p d.q (d.demandMatrix DG) R σ (P.mean d.p d.q C) +
                ((d.eta (d.partition.group i) - σ) * ((d.p i * d.q i)⁻¹ + (d.p j * d.q j)⁻¹) * t ^ 2) •
