@CommodityClassification.DemandNests.Data.actual_demand_optimal : ∀ {n g : ℕ}
  (d : CommodityClassification.DemandNests.Data n g) {r : CommodityClassification.DemandNests.Vec n},
  (∀ (i : Fin n), 0 < r i) →
    ∀ (outer : CommodityClassification.DemandNests.Vec g → CommodityClassification.DemandNests.Vec g)
      (U : CommodityClassification.DemandNests.Vec g → ℝ) (Ω : Set (CommodityClassification.DemandNests.Vec g)),
      (∀ (a : Fin g), 0 < outer (d.priceMap r) a) →
        outer (d.priceMap r) ∈ Ω →
          (∀ Z ∈ Ω, U Z - d.priceMap r ⬝ᵥ Z ≤ U (outer (d.priceMap r)) - d.priceMap r ⬝ᵥ outer (d.priceMap r)) →
            (∀ (i : Fin n), 0 < d.demand outer r i) ∧
              d.quantityMap (d.demand outer r) ∈ Ω ∧
                IsMaxOn (fun x => U (d.quantityMap x) - r ⬝ᵥ x) {x | (∀ (i : Fin n), 0 ≤ x i) ∧ d.quantityMap x ∈ Ω}
                  (d.demand outer r)
