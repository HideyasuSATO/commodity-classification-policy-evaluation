  (c e : CommodityClassification.InputCoordinates.Vec n),
  d.Admissible c →
    e ∈ d.closedFiber P (d.groupTotal P c) →
      ∀ (q : ℝ),
        d.lowerMoment P (d.groupTotal P c) ≤ q →
          q < d.secondMoment e →
            ∃ t,
              0 ≤ t ∧
                t < 1 ∧
                  d.endpointPath P c e t ∈ d.positiveFiber P (d.groupTotal P c) ∧
                    d.secondMoment (d.endpointPath P c e t) = q
