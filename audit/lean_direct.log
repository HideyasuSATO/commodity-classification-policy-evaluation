 Classical.choice,
 Quot.sound]
@CommodityClassification.Precision.Data.sigmaConditionalWidth_reduced_upper : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) (l u : ℝ),
  0 < l →
    l ≤ u →
      ∀ (c : CommodityClassification.InputCoordinates.Vec n),
        d.Admissible c →
