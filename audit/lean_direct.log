  (W D0 : CommodityClassification.Equilibrium.Mat n n),
  Matrix.PosSemidef W →
    Matrix.PosSemidef D0 →
      ∀ (a τ : ℝ),
        0 ≤ a →
          0 ≤ τ →
            Matrix.PosSemidef (a • D0 - W) →
              ∀ (b0 h : CommodityClassification.Equilibrium.Vec n),
                h ⬝ᵥ Matrix.mulVec D0 h ≤ τ ^ 2 * b0 ⬝ᵥ Matrix.mulVec D0 b0 →
                  |h ⬝ᵥ Matrix.mulVec W b0| ≤ a * τ * b0 ⬝ᵥ Matrix.mulVec D0 b0 ∧
                    h ⬝ᵥ Matrix.mulVec W h ≤ a * τ ^ 2 * b0 ⬝ᵥ Matrix.mulVec D0 b0
