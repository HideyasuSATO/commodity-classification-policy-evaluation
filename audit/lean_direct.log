@CommodityClassification.Precision.Data.uniform_actual_witnesses : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) {N : ℕ → ℕ}
  (E : (j : ℕ) → CommodityClassification.Precision.Data (N j)) (m : ℕ → ℕ),
  (∀ (j : ℕ), (E j).eta = d.eta) →
    (∀ (j : ℕ), (E j).alpha = d.alpha) →
      (∀ (j : ℕ), (E j).beta = d.beta) →
        (∀ (j : ℕ), (E j).sigma = d.sigma) →
          Filter.Tendsto (fun j => (E j).coarseSales (m j)) Filter.atTop (nhds 0) →
            ∀ eps < d.precisionFloor,
              ∃ δ,
                0 < δ ∧
                  ∀ᶠ (j : ℕ) in Filter.atTop,
                    ∀ (P : CommodityClassification.InputCoordinates.Partition (N j) (m j)),
                      ∃ c,
                        ∃ (hc : (E j).Admissible c),
                          (E j).groupTotal P c = (E j).groupTotal P (E j).criticalInputs ∧
                            (E j).theta c = (E j).theta (E j).criticalInputs ∧
                              (∀ (i : Fin (N j)) (a : Fin 2),
                                  δ ≤ (E j).inputs (E j).criticalInputs i a ∧ δ ≤ (E j).inputs c i a) ∧
                                eps <
                                  |((E j).family.model ((E j).candidate (E j).criticalInputs ⋯)).lossCoefficient /
                                        (E j).nu -
                                      ((E j).family.model ((E j).candidate c hc)).lossCoefficient / (E j).nu|
'CommodityClassification.Precision.Data.uniform_actual_witnesses' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@CommodityClassification.Precision.Data.uniform_positive_witnesses : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) {N : ℕ → ℕ}
  (E : (j : ℕ) → CommodityClassification.Precision.Data (N j)) (m : ℕ → ℕ),
  (∀ (j : ℕ), (E j).eta = d.eta) →
    (∀ (j : ℕ), (E j).alpha = d.alpha) →
      (∀ (j : ℕ), (E j).beta = d.beta) →
        (∀ (j : ℕ), (E j).sigma = d.sigma) →
          Filter.Tendsto (fun j => (E j).coarseSales (m j)) Filter.atTop (nhds 0) →
            ∀ eps < d.precisionFloor,
              ∃ t δ,
                0 ≤ t ∧
                  t < 1 ∧
                    δ = d.shareFloor t ∧
                      0 < δ ∧
                        ∀ᶠ (j : ℕ) in Filter.atTop,
                          ∀ (P : CommodityClassification.InputCoordinates.Partition (N j) (m j)),
                            ∃ c,
                              (E j).Admissible c ∧
                                (E j).groupTotal P c = (E j).groupTotal P (E j).criticalInputs ∧
                                  (E j).theta c = (E j).theta (E j).criticalInputs ∧
                                    (∀ (i : Fin (N j)) (a : Fin 2),
                                        δ ≤ (E j).inputs (E j).criticalInputs i a ∧ δ ≤ (E j).inputs c i a) ∧
                                      eps < |(E j).normalizedWelfare (E j).criticalInputs - (E j).normalizedWelfare c|
'CommodityClassification.Precision.Data.uniform_positive_witnesses' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
