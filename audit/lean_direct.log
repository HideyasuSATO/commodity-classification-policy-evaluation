@CommodityClassification.Equilibrium.BenchmarkFamily.perturbation_energy_bounds : ∀ {n k g : ℕ}
  (F : CommodityClassification.Equilibrium.BenchmarkFamily n k g) (D : CommodityClassification.Equilibrium.Mat n n)
  (b : CommodityClassification.Equilibrium.Vec n) (δ τ : ℝ),
  0 ≤ δ →
    ∀ (hδ1 : δ < 1),
      0 ≤ τ →
        τ < 1 →
          ∀ (hlo : Matrix.PosSemidef (D - (1 - δ) • F.D)),
            Matrix.PosSemidef ((1 + δ) • F.D - D) →
              (b - F.b) ⬝ᵥ Matrix.mulVec F.D (b - F.b) ≤ τ ^ 2 * F.benchmarkEnergy →
                have hD := ⋯;
                CommodityClassification.Robust.normalizationLower δ τ * F.benchmarkEnergy ≤
                    (F.withDemandPolicy D hD b).benchmarkEnergy ∧
                  (F.withDemandPolicy D hD b).benchmarkEnergy ≤
                    CommodityClassification.Robust.normalizationUpper δ τ * F.benchmarkEnergy
