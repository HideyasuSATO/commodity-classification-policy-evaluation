 Classical.choice,
 Quot.sound]
@CommodityClassification.Precision.Data.sigmaConditionalWidth_odds : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) (l u : ℝ),
  0 < l →
    l ≤ u →
      ∀ (c : CommodityClassification.InputCoordinates.Vec n),
        d.Admissible c →
          d.sigmaConditionalWidth l u c =
            d.lossScale * d.sigmaOddsExposure c * (u - l) /
              ((l + d.eta * d.sigmaOddsMoment c + d.alpha * d.sigmaOddsExposure c) *
                (u + d.eta * d.sigmaOddsMoment c + d.alpha * d.sigmaOddsExposure c))
