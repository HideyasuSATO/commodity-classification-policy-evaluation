  (d : CommodityClassification.Precision.Data n) (l u : ℝ),
  0 < l →
    l ≤ u →
      ∀ (c : CommodityClassification.InputCoordinates.Vec n),
        d.Admissible c →
          ∀ (x : ℝ),
            d.theta c ^ 2 = x →
              d.secondMoment c = x →
                d.sigmaConditionalWidth l u c =
                  CommodityClassification.Precision.Envelope.value l u d.totalElasticity d.lossScale x
'CommodityClassification.Precision.Data.sigmaConditionalWidth_equal_moments' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@CommodityClassification.Precision.Data.sigmaConditionalWidth_formula : ∀ {n : ℕ}
  (d : CommodityClassification.Precision.Data n) (l u : ℝ),
  0 < l →
    l ≤ u →
      ∀ (c : CommodityClassification.InputCoordinates.Vec n),
        d.Admissible c →
          d.sigmaConditionalWidth l u c =
            d.lossScale * d.theta c ^ 2 * (u - l) * (1 - d.secondMoment c) /
              (d.denominator l (d.secondMoment c) (d.theta c ^ 2) * d.denominator u (d.secondMoment c) (d.theta c ^ 2))
'CommodityClassification.Precision.Data.sigmaConditionalWidth_formula' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
