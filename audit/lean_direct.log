 Classical.choice,
 Quot.sound]
@CommodityClassification.DemandNests.Data.actual_proportional_quantity_derivative : ∀ {n g : ℕ}
  (d : CommodityClassification.DemandNests.Data n g)
  (outer : CommodityClassification.DemandNests.Vec g → CommodityClassification.DemandNests.Vec g)
  (DG : Matrix (Fin g) (Fin g) ℝ),
  (outer fun x => 1) = d.partition.sales d.p d.q →
    (HasFDerivAt outer (-CommodityClassification.Equilibrium.matCLM DG) fun x => 1) →
      ∀ (β : CommodityClassification.DemandNests.Vec g),
        (fderiv ℝ (d.demand outer) d.p) (d.proportionalPolicy β) =
          -Matrix.mulVec (d.partition.Q d.q)
              ((Matrix.diagonal fun a => (d.partition.sales d.p d.q a)⁻¹).mulVec (DG.mulVec β))
