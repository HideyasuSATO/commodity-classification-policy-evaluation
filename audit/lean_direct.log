@CommodityClassification.DemandNest.Data.ces_primal_dual_complete : ∀ {n : ℕ}
  (d : CommodityClassification.DemandNest.Data n),
  ContinuousOn d.quantityOnNonnegative {x | ∀ (i : Fin n), 0 ≤ x i} ∧
    (∀ (x : CommodityClassification.DemandNest.Vec n),
        (∀ (i : Fin n), 0 < x i) → d.quantityOnNonnegative x = d.quantityIndex x) ∧
      ∀ (r : Fin n → ℝ),
        (∀ (i : Fin n), 0 < r i) →
          IsLeast {v | ∃ x, (∀ (i : Fin n), 0 ≤ x i) ∧ 1 ≤ d.quantityOnNonnegative x ∧ v = r ⬝ᵥ x}
              (d.expenditureIndex r) ∧
            ∃! x, (∀ (i : Fin n), 0 ≤ x i) ∧ 1 ≤ d.quantityOnNonnegative x ∧ r ⬝ᵥ x = d.expenditureIndex r
